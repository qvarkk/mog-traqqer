# Copy to .env for local development: cp .env.example .env
# Real environment variables always win over .env, and a missing .env is not an error.

# --- application (both services) -------------------------------------------------
# development | staging | production
APP_ENV=development
APP_NAME=go-fiber-template

# --- logging (both services) ----------------------------------------------------
# debug | info | warn | error | dpanic | panic | fatal
LOG_LEVEL=debug

# Optional. Empty logs to stdout only; when set, rotated JSON is written there too.
LOG_FILE=

# --- http server (gateway only) -------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Maximum request body size in bytes (4194304 = 4 MiB).
HTTP_BODY_LIMIT=4194304

# Comma-separated browser origins. "*" is development-only.
HTTP_CORS_ALLOWED_ORIGINS=*

# --- users service client (gateway only) ----------------------------------------
USERS_ADDR=localhost:9090

# --- grpc server (users service only) -------------------------------------------
# GRPC_ENABLED=false leaves the listener off while the server is still built.
GRPC_ENABLED=true
GRPC_HOST=0.0.0.0
GRPC_PORT=9090

# Reflection lets grpcurl discover the API; it advertises the whole surface, so
# turn it off in production.
GRPC_REFLECTION_ENABLED=true

GRPC_SHUTDOWN_TIMEOUT=10s
GRPC_CONNECTION_TIMEOUT=10s

# Maximum message size in bytes (4 MiB is the gRPC default).
GRPC_MAX_RECV_MSG_SIZE=4194304
GRPC_MAX_SEND_MSG_SIZE=4194304

# --- database (users service only) ----------------------------------------------
# Set DB_URL to use a complete connection string and ignore the DB_* values below.
DB_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app

# disable | allow | prefer | require | verify-ca | verify-full
# "disable" is for the local docker-compose database only.
DB_SSL_MODE=disable

DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=5s

# Apply the embedded migrations at startup; turn off once migrations are a
# separate deployment step.
DB_AUTO_MIGRATE=true

# --- auth (users service only) ------------------------------------------------
# Secret for signing access tokens. Long and random; set in production.
AUTH_JWT_SECRET=change-me-in-production

# Token lifetimes.
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h

# argon2id cost parameters (memory in KiB).
AUTH_ARGON2_MEMORY=65536
AUTH_ARGON2_ITERATIONS=1
AUTH_ARGON2_PARALLELISM=4

# --- internationalisation (gateway only) ----------------------------------------
# Must have a catalog in internal/i18n/locales.
I18N_DEFAULT_LANGUAGE=en

# Explicit per-request override: /api/v1/users?lang=ru
I18N_QUERY_PARAM=lang

# Per-user preference, used when the query parameter is absent.
I18N_COOKIE_NAME=lang
